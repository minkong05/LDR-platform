# Local dev defaults
ENV=local

# Local (host) DB URL for running pytest/alembic/cli on your machine
DATABASE_URL=postgresql+psycopg://ldr:ldr@localhost:5432/ldr

# Docker (container) DB URL for backend/worker services
DATABASE_URL_DOCKER=postgresql+psycopg://ldr:ldr@postgres:5432/ldr

# Agent auth (shared secret for local demo; rotate in real use)
AGENT_TOKEN=dev-agent-token-change-me
AGENT_TOKEN_1=change_me_agent_token
DASHBOARD_API_TOKEN=dev-dashboard-api-token-change-me

# Retention
EVENT_RETENTION_DAYS=14

# Redis (we'll use this for worker later)
REDIS_URL=redis://redis:6379/0

# App secrets (set properly later)
SECRET_KEY=change_me_to_a_long_random_string

# ── Dashboard login (session auth, two roles) ────────────────────
# Format: "username:werkzeug-password-hash:role,..." — role is "analyst"
# or "admin" (defaults to "analyst" if omitted). analyst can investigate/
# triage/summarize; only admin can block/unblock IPs. Generate a hash with:
#   python -c "from werkzeug.security import generate_password_hash as g; print(g('yourpassword'))"
# Below: admin/test123 and analyst/test123 — local dev only.
# NOTE: werkzeug hashes contain literal "$" — Compose interpolates .env values,
# so every "$" below is escaped as "$$" (de-escaped back to "$" in the container).
DASHBOARD_USERS=admin:scrypt:32768:8:1$$od8JM7slhYHmwgeA$$f22347a7f29196e0f9d1afb80b0864154702a31f3ea0e362582660979ff7b0b76e4c8655757b2f7664102264b4af0b097ea576fb10ba89f26e15835c81ead6f2:admin,analyst:scrypt:32768:8:1$$3wS4VGhAGeDPN6dq$$8cb2f1e7f0c7452d5769edd02a38c51478e1fae104fc55dd4813f1d0a1096415be6eceecb1f9ee0dddee19a1d09791ca4b1268eae0e97e0dd8b6c1378b4aeb76:analyst
# Set true when serving the dashboard over HTTPS
SESSION_COOKIE_SECURE=false
PERMANENT_SESSION_LIFETIME_SECONDS=28800

# Detection worker
DETECTION_INTERVAL_SECONDS=30
DETECTION_LOOKBACK_MINUTES=30
RULES_DIR=/app/rules

# ── Email notifications ────────────────────────────────────────
# Set SMTP_ENABLED=false to disable notifications without removing config
SMTP_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@gmail.com
SMTP_TO=alerts@example.com
# Severities that trigger email — comma-separated
ALERT_EMAIL_SEVERITIES=high,critical

# ── LLM alert summarization (optional) ──────────────────────────
# Leave LLM_API_KEY blank to disable — the summary card is hidden and no
# network calls are attempted. See docs/ai-security-notes.md for the
# prompt-injection threat model this feature is built around.
LLM_API_KEY=
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-4-5-20251001
LLM_REQUEST_TIMEOUT_SECONDS=10

